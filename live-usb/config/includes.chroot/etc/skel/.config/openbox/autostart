#!/bin/sh
# The entire graphical "desktop" this live session ever shows: no panel, no
# taskbar, no icons -- one fullscreen browser window pointed at the NeuroClaw
# app on :7861, which the backend serves itself (the home chat at /, Settings
# at /settings). There is no separate frontend server any more. systemd starts
# that service independently of this login session (in parallel, not before
# it), and unlike scripts/launcher.mjs's own self-reloading "Starting..." page,
# a plain connection-refused error page in chromium does NOT retry itself -- so
# this waits for the engine to actually answer before launching chromium the
# first time, instead of leaving a dead error page up that nothing here would
# notice or recover from.

# No screensaver/blanking -- an unattended kiosk going dark mid-demo reads
# as "it crashed", not "it's idle".
xset s off
xset -dpms
xset s noblank

# `npm run dev` runs a cold `tsc` build on every boot (the build output under
# /opt/neuroclaw does not persist between boots on a plain live session), which
# can take a while on slow hardware -- see neuroclaw-dev.service's own doc
# comment. No fixed upper bound: an old/slow machine just waits longer rather
# than giving up and showing nothing. /api/status answers 200 only once the
# engine is really up.
until curl -sf -o /dev/null "http://127.0.0.1:7861/api/status"; do
  sleep 1
done

# Loop, not a single launch: if chromium itself ever exits (a crash, an
# accidental Alt+F4 nobody meant to reach), the kiosk comes back instead of
# leaving a bare X background with nothing on it and no way back in short
# of a reboot.
while true; do
  chromium \
    --kiosk \
    --incognito \
    --no-first-run \
    --disable-infobars \
    --noerrdialogs \
    --disable-session-crashed-bubble \
    --disable-translate \
    --check-for-update-interval=31536000 \
    --user-data-dir=/tmp/neuroclaw-kiosk-profile \
    'http://127.0.0.1:7861/' \
    >/tmp/neuroclaw-kiosk.log 2>&1
  sleep 1
done &
