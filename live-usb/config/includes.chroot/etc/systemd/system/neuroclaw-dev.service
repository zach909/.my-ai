[Unit]
Description=NeuroClaw (the app: the backend serves the whole interface itself)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/neuroclaw
# `npm run dev` (scripts/dev.mjs): rebuilds the backend, then runs it in the
# foreground. The backend serves the whole app itself on :7861 -- the home chat
# at /, Settings at /settings, the API under /api -- with Node built-ins only;
# there is no separate frontend dev server. It listens on this computer's
# loopback address only, which is all the kiosk browser needs.
ExecStart=/usr/bin/npm run dev
Restart=on-failure
RestartSec=2
Environment=NEUROCLAW_SELF_IMPROVE=0
Environment=NEUROCLAW_SKILL_AGENT=0
Environment=NEUROCLAW_CONVERSATION_LEARNING=0
Environment=NEUROCLAW_SKILL_DRILL=0
Environment=NEUROCLAW_OPTIMIZE_AGENT=0
Environment=NEUROCLAW_PEER_SYNC=0
# Set ONLY here -- this is what makes the app's own "Install NeuroClaw"
# option (GET/POST /api/system/live-usb, /api/system/install in
# interface/web-server.ts) appear at all. A normal install/dev machine
# never sets this and never sees it.
Environment=NEUROCLAW_LIVE_USB=1

[Install]
WantedBy=multi-user.target
