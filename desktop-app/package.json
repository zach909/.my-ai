{
  "name": "neuroclaw-desktop",
  "version": "1.0.0",
  "description": "NeuroClaw \u2014 local-first AI agent, powered by the OneBrain neural mesh",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/ipc-handlers.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl",
    "prebuild": "node ../scripts/stage-desktop-dist.mjs",
    "prebuild:win": "node ../scripts/stage-desktop-dist.mjs",
    "prebuild:mac": "node ../scripts/stage-desktop-dist.mjs",
    "prebuild:linux": "node ../scripts/stage-desktop-dist.mjs",
    "prebuild:all": "node ../scripts/stage-desktop-dist.mjs"
  },
  "keywords": [
    "electron",
    "desktop",
    "cross-platform"
  ],
  "author": {
    "name": "zach909",
    "email": "zach909@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.neuroclaw.app",
    "productName": "NeuroClaw",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "desktop": {
        "entry": {
          "Name": "NeuroClaw",
          "Comment": "Local-first AI agent powered by the OneBrain neural mesh",
          "Categories": "Development;Science;Utility;"
        }
      },
      "maintainer": "zach909 <zach909@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "publish": null,
    "extraResources": [
      {
        "from": "../desktop-app/.staged-dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "homepage": "https://github.com/zach909/.my-ai",
  "desktopName": "neuroclaw.desktop",
  "dependencies": {
    "selfsigned": "^5.5.0"
  }
}
