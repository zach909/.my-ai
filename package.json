{
  "name": "neuroclaw",
  "description": "NeuroClaw — a local-first AI agent powered by the OneBrain neural mesh engine.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node scripts/server.mjs",
    "launch": "node scripts/launcher.mjs",
    "check:third-party": "node scripts/check-no-third-party.mjs",
    "build:native": "node scripts/build-native.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "lint:types": "tsc -p tsconfig.backend.json --noEmit",
    "lint": "npm run check:third-party && npm run lint:types",
    "test:smoke": "node scripts/build-backend.mjs && node test/smoke.mjs",
    "test:integration": "vitest run",
    "test:install": "bash test/install-sh.test.sh",
    "test:platform": "node scripts/build-backend.mjs && node --test --test-concurrency=2 \"test/platform/*.test.mjs\"",
    "test": "npm run check:third-party && npm run test:smoke && npm run test:platform && npm run test:integration && npm run test:install",
    "release:version": "node scripts/release/version.mjs",
    "release:extension": "node scripts/release/build-extension.mjs",
    "build:phone-brain": "node scripts/release/build-mobile-brain.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {}
}
