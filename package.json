{
  "name": "neuroclaw",
  "description": "NeuroClaw — a local-first AI agent powered by the OneBrain neural mesh engine.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend-only": "vite",
    "server": "node scripts/server.mjs",
    "launch": "node scripts/launcher.mjs",
    "build": "vite build && node scripts/finalize-static-build.mjs",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.css\" --fix --quiet",
    "lint:js": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "lint:types": "tsc --noEmit",
    "lint": "npm run lint:types && npm run lint:js && npm run lint:css",
    "test:smoke": "node scripts/build-backend.mjs && node test/smoke.mjs",
    "test:integration": "vitest run",
    "test:install": "bash test/install-sh.test.sh",
    "test": "npm run test:smoke && npm run test:integration && npm run test:install",
    "bench:hyper": "bun benchmarks/hyper_benchmark.ts",
    "bench:mesh": "bun benchmarks/mesh_benchmark.ts",
    "bench:mesh-parallel": "bun benchmarks/mesh_parallel_benchmark.ts",
    "bench:moe": "bun benchmarks/moe_benchmark.ts",
    "bench": "bun run bench:hyper && bun run bench:mesh && bun run bench:mesh-parallel && bun run bench:moe"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "typescript": "~6.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.11",
    "@tanstack/react-start": "1.168.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "4.2.2",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "valibot": "^1.0.0"
  },
  "pnpm": {
    "overrides": {
      "valibot": "^1.0.0"
    }
  }
}
