{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "interface/**/*",
    "models && skills/**/*",
    "plugin_manager/**/*",
    "plugins/**/*",
    "extension-builder/**/*"
  ]
}
