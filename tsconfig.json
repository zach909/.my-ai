{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "interface/**/*.ts",
    "models && skills/**/*.ts",
    "extension-builder/**/*.ts",
    "plugin_manager/**/*.ts",
    "plugins/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
