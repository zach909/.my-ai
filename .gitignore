```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled Python files
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Coverage reports
.coverage
htmlcov/
coverage/

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS specific
.DS_Store
Thumbs.db
```